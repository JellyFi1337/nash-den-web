# Только на сервере: какие файлы Compose собирать (docs/DEPLOY.md, раздел 7).
# Без SSL — так; с HTTPS — compose.yaml:compose.prod.yaml. На компьютере разработчика не включайте.
# COMPOSE_FILE=compose.yaml:compose.prod.yaml:compose.http.yaml
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-not-a-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_PATH=dkr-admin/
POSTGRES_DB=nashden
POSTGRES_USER=nashden
POSTGRES_PASSWORD=nashden
POSTGRES_HOST=db
POSTGRES_PORT=5432
SITE_URL=http://localhost:8000
SITE_DOMAIN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_OWNER_ID=
# 1 — бот каждое утро сам рассылает код. По умолчанию 0: код берут у бота по /code.
CODE_BROADCAST=0
CHATS_CONFIG=/app/private/chats.toml
# ссылка на таблицу команды; сайт только читает её (docs/SHEET.md)
SHEET_URL=
SHEET_TTL=900
SHEET_TIMEOUT=10

TRUSTED_PROXY_COUNT=0
DJANGO_SECURE_COOKIES=0
DJANGO_HSTS_SECONDS=0
# 1 — только для своего домена, когда HTTPS уже проверен. Для чужого поддомена не включайте.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
# Необязательный контакт для сертификата. Пусто — Caddy запросит сертификат без email.
ACME_EMAIL=
TZ=Europe/Moscow
